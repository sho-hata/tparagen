Name: nested subtest already parallel: the outer subtest still gets Parallel
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Run("outer", func(t *testing.T) {
		t.Run("inner", func(t *testing.T) {
			t.Parallel()
		})
	})
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	t.Run("outer", func(t *testing.T) {
		t.Parallel()
		t.Run("inner", func(t *testing.T) {
			t.Parallel()
		})
	})
}
