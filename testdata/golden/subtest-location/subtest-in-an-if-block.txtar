Name: subtest in an if block
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	if !testing.Short() {
		t.Run("1", func(t *testing.T) {
			fmt.Println("1")
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	if !testing.Short() {
		t.Run("1", func(t *testing.T) {
			t.Parallel()
			fmt.Println("1")
		})
	}
}
