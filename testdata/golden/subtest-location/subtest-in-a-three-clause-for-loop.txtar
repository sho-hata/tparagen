Name: subtest in a three-clause for loop
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	cases := []string{"a"}
	for i := 0; i < len(cases); i++ {
		t.Run(cases[i], func(t *testing.T) {
			fmt.Println(cases[i])
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	cases := []string{"a"}
	for i := 0; i < len(cases); i++ {
		t.Run(cases[i], func(t *testing.T) {
			t.Parallel()
			fmt.Println(cases[i])
		})
	}
}
