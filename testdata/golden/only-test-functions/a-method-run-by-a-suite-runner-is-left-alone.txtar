Name: a method run by a suite runner is left alone
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

type s struct{}

func (s) TestX(t *testing.T) {
	t.Run("1", func(t *testing.T) {
		fmt.Println("1")
	})
}

func Test(t *testing.T) {
	runSuite(t, s{})
}
-- golden.go --
package t

import "testing"

type s struct{}

func (s) TestX(t *testing.T) {
	t.Run("1", func(t *testing.T) {
		fmt.Println("1")
	})
}

func Test(t *testing.T) {
	t.Parallel()
	runSuite(t, s{})
}
