Name: nolint at the end of the func line excludes the test
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) { //nolint:tparallel // shares the global config
	t.Run("1", func(t *testing.T) {
		run(t)
	})
}

func TestY(t *testing.T) {
	run(t)
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) { //nolint:tparallel // shares the global config
	t.Run("1", func(t *testing.T) {
		run(t)
	})
}

func TestY(t *testing.T) {
	t.Parallel()
	run(t)
}
