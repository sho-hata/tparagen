Name: a loop variable used only as the subtest name is not copied
NeedFixLoopVar: true
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	cases := []string{"a"}
	for _, tc := range cases {
		t.Run(tc, func(t *testing.T) {
			fmt.Println("hi")
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	cases := []string{"a"}
	for _, tc := range cases {
		t.Run(tc, func(t *testing.T) {
			t.Parallel()
			fmt.Println("hi")
		})
	}
}
