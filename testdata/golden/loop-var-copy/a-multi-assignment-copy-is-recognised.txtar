Name: a multi-assignment copy is recognised
NeedFixLoopVar: true
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	cases := []string{"a"}
	for i, tc := range cases {
		i, tc := i, tc
		t.Run(tc, func(t *testing.T) {
			fmt.Println(i, tc)
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	cases := []string{"a"}
	for i, tc := range cases {
		i, tc := i, tc
		t.Run(tc, func(t *testing.T) {
			t.Parallel()
			fmt.Println(i, tc)
		})
	}
}
