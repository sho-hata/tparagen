Name: package variable assigned in a subtest: only the sibling gets Parallel
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Run("stub", func(t *testing.T) {
		now = func() time.Time { return fixed }
	})
	t.Run("plain", func(t *testing.T) {
		fmt.Println("1")
	})
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Run("stub", func(t *testing.T) {
		now = func() time.Time { return fixed }
	})
	t.Run("plain", func(t *testing.T) {
		t.Parallel()
		fmt.Println("1")
	})
}
