Name: a table field holding a function literal calling Setenv counts
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	tests := []struct {
		name  string
		setup func(t *testing.T)
	}{
		{name: "env", setup: func(t *testing.T) { t.Setenv("KEY", "value") }},
		{name: "none", setup: func(t *testing.T) {}},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			tc.setup(t)
			run(t)
		})
	}
}

func TestY(t *testing.T) {
	tests := []struct {
		name  string
		setup func(t *testing.T)
	}{
		{name: "none", setup: func(t *testing.T) { t.Log("x") }},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			tc.setup(t)
			run(t)
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	tests := []struct {
		name  string
		setup func(t *testing.T)
	}{
		{name: "env", setup: func(t *testing.T) { t.Setenv("KEY", "value") }},
		{name: "none", setup: func(t *testing.T) {}},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			tc.setup(t)
			run(t)
		})
	}
}

func TestY(t *testing.T) {
	t.Parallel()
	tests := []struct {
		name  string
		setup func(t *testing.T)
	}{
		{name: "none", setup: func(t *testing.T) { t.Log("x") }},
	}
	for _, tc := range tests {
		t.Run(tc.name, func(t *testing.T) {
			t.Parallel()
			tc.setup(t)
			run(t)
		})
	}
}
