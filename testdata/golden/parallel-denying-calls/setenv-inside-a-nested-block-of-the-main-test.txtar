Name: Setenv inside a nested block of the main test
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	if os.Getenv("CI") != "" {
		t.Setenv("X", "y")
	}
	t.Run("1", func(t *testing.T) {
		fmt.Println("1")
	})
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	if os.Getenv("CI") != "" {
		t.Setenv("X", "y")
	}
	t.Run("1", func(t *testing.T) {
		t.Parallel()
		fmt.Println("1")
	})
}
