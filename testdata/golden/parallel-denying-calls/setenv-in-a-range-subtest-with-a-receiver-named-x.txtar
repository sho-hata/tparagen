Name: Setenv in a range subtest with a receiver named x
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	testCases := []struct {
		name string
	}{{name: "foo"}}
	for _, tc := range testCases {
		t.Run(tc.name, func(x *testing.T) {
			x.Setenv("X", "y")
			fmt.Println(tc.name)
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	testCases := []struct {
		name string
	}{{name: "foo"}}
	for _, tc := range testCases {
		t.Run(tc.name, func(x *testing.T) {
			x.Setenv("X", "y")
			fmt.Println(tc.name)
		})
	}
}
