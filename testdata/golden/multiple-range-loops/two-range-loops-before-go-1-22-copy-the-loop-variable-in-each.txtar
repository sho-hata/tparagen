Name: two range loops before Go 1.22 copy the loop variable in each
NeedFixLoopVar: true
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	for _, tc := range []string{"a"} {
		t.Run(tc, func(t *testing.T) {
			fmt.Println(tc)
		})
	}
	for _, tc := range []string{"b"} {
		t.Run(tc, func(t *testing.T) {
			fmt.Println(tc)
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	for _, tc := range []string{"a"} {
		tc := tc
		t.Run(tc, func(t *testing.T) {
			t.Parallel()
			fmt.Println(tc)
		})
	}
	for _, tc := range []string{"b"} {
		tc := tc
		t.Run(tc, func(t *testing.T) {
			t.Parallel()
			fmt.Println(tc)
		})
	}
}
