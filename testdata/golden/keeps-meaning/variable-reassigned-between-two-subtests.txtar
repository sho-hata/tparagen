Name: variable reassigned between two subtests
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	want := 1
	t.Run("one", func(t *testing.T) {
		fmt.Println(want)
	})
	want = 2
	t.Run("two", func(t *testing.T) {
		fmt.Println(want)
	})
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	want := 1
	t.Run("one", func(t *testing.T) {
		fmt.Println(want)
	})
	want = 2
	t.Run("two", func(t *testing.T) {
		fmt.Println(want)
	})
}
