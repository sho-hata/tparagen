Name: go1.22 build constraint does not
NeedFixLoopVar: false
-- input.go --
//go:build go1.22 && linux

package t

import "testing"

func TestX(t *testing.T) {
	for _, tc := range []string{"a"} {
		t.Run(tc, func(t *testing.T) {
			fmt.Println(tc)
		})
	}
}
-- golden.go --
//go:build go1.22 && linux

package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	for _, tc := range []string{"a"} {
		t.Run(tc, func(t *testing.T) {
			t.Parallel()
			fmt.Println(tc)
		})
	}
}
