Name: missing t.Parallel in sub test function Main Test has t.Setenv
NeedFixLoopVar: true
-- input.go --
package t

import "testing"

func TestSubFunctionMissingParallelSubTestHasSetenv(t *testing.T) {
	t.Setenv("TEST", "test")
	t.Run("1", func(t *testing.T) {
		fmt.Println("1")
	})
}
-- golden.go --
package t

import "testing"

func TestSubFunctionMissingParallelSubTestHasSetenv(t *testing.T) {
	t.Setenv("TEST", "test")
	t.Run("1", func(t *testing.T) {
		t.Parallel()
		fmt.Println("1")
	})
}
