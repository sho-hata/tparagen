-- golden.go --
package t

import "testing"

func TestFunctionMissingParallelInMainSubTestHasParallel(t *testing.T) {
	t.Parallel()
	t.Run("1", func(t *testing.T) {
		t.Parallel()
		fmt.Println("1")
	})
}
