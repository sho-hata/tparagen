Name: blank receiver in a range subtest: only the parent gets Parallel
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	cases := []string{"a"}
	for _, tc := range cases {
		t.Run(tc, func(_ *testing.T) {
			fmt.Println(tc)
		})
	}
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	cases := []string{"a"}
	for _, tc := range cases {
		t.Run(tc, func(_ *testing.T) {
			fmt.Println(tc)
		})
	}
}
