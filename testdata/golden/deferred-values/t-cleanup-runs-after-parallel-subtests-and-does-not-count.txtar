Name: t.Cleanup runs after parallel subtests and does not count
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	srv := httptest.NewServer(h)
	t.Cleanup(srv.Close)

	t.Run("1", func(t *testing.T) {
		get(t, srv.URL)
	})
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	srv := httptest.NewServer(h)
	t.Cleanup(srv.Close)

	t.Run("1", func(t *testing.T) {
		t.Parallel()
		get(t, srv.URL)
	})
}
