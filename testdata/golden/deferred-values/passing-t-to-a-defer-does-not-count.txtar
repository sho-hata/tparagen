Name: passing t to a defer does not count
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	be := newBackend(t)
	defer closeBackend(t, be)

	t.Run("1", func(t *testing.T) {
		fmt.Println("1")
	})
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	be := newBackend(t)
	defer closeBackend(t, be)

	t.Run("1", func(t *testing.T) {
		t.Parallel()
		fmt.Println("1")
	})
}
