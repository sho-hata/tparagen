Name: a defer that the subtests do not use does not matter
NeedFixLoopVar: false
-- input.go --
package t

import "testing"

func TestX(t *testing.T) {
	f := open(t)
	defer f.Close()

	t.Run("1", func(t *testing.T) {
		fmt.Println("1")
	})
}
-- golden.go --
package t

import "testing"

func TestX(t *testing.T) {
	t.Parallel()
	f := open(t)
	defer f.Close()

	t.Run("1", func(t *testing.T) {
		t.Parallel()
		fmt.Println("1")
	})
}
